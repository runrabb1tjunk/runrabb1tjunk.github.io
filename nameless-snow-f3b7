// Автоматическая сверка: удаление записей расходов, если картины больше нет на стене
async function syncSpentPointsWithPlacedPaintings(env, userId, username) {
  try {
    const placed = await env.DB.prepare(
      `SELECT id FROM placed_paintings WHERE username = ?`
    ).bind(username).all();
    
    const placedIds = new Set((placed.results || []).map(r => r.id));

    const spentRecords = await env.DB.prepare(
      `SELECT id, painting_id FROM user_points_spent WHERE user_id = ? AND painting_id IS NOT NULL`
    ).bind(userId).all();

    for (const record of (spentRecords.results || [])) {
      if (!placedIds.has(record.painting_id)) {
        await env.DB.prepare(
          `DELETE FROM user_points_spent WHERE id = ?`
        ).bind(record.id).run();
      }
    }
  } catch (e) {
    console.error("Ошибка синхронизации расходов баллов:", e);
  }
}

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response("OK", { status: 200, headers: corsHeaders });
    }

    const workerUrl = new URL(request.url);
    const POLYGON_RPC_URL = "https://polygon-mainnet.g.alchemy.com/v2/TMbYtqLMNx-j6CT-UU6mM";
    const KOWASUGI_CONTRACT = "0x3047511c064Ba6319814aA80b56d3E97002cb343";
    const CONCEAL_CONTRACT  = "0x137Ee749f0F8c2eD34cA00dE33BB59E3dafA494A";

    if (request.method === "POST") {
      const body = await request.json().catch(() => ({}));

      // 1. РЕГИСТРАЦИЯ (С гарантированным начислением приветственных 100 баллов)
      if (workerUrl.pathname === "/api/register") {
        const { username, password } = body;
        if (!username || !password) {
          return new Response(JSON.stringify({ error: "Заполните все поля" }), { status: 400, headers: corsHeaders });
        }
        const passwordHash = await hashPassword(password);
        try {
          // Сначала проверяем, не существует ли уже пользователь
          const existing = await env.DB.prepare(`SELECT id FROM users WHERE username = ?`).bind(username).first();
          if (existing) {
            return new Response(JSON.stringify({ error: "Пользователь уже существует" }), { status: 409, headers: corsHeaders });
          }

          // Создаем пользователя
          await env.DB.prepare(`INSERT INTO users (username, password_hash) VALUES (?, ?)`).bind(username, passwordHash).run();
          
          // Точно выбираем ID только что созданного пользователя по имени
          const newUser = await env.DB.prepare(`SELECT id FROM users WHERE username = ?`).bind(username).first();
          
          if (newUser && newUser.id) {
            // Начисляем 100 приветственных баллов через отрицательное значение в таблицу расходов (как пополнение)
            await env.DB.prepare(
              `INSERT INTO user_points_spent (user_id, amount, description, painting_id) VALUES (?, ?, ?, ?)`
            ).bind(newUser.id, -100, "Приветственный бонус за регистрацию", null).run();
          }

          return new Response(JSON.stringify({ success: true, message: "Регистрация успешна, начислено 100 приветственных баллов!" }), { status: 201, headers: corsHeaders });
        } catch (e) {
          return new Response(JSON.stringify({ error: "Ошибка регистрации: " + e.message }), { status: 500, headers: corsHeaders });
        }
      }

      // 2. ВХОД
      if (workerUrl.pathname === "/api/login") {
        const { username, password } = body;
        const passwordHash = await hashPassword(password);
        
        const user = await env.DB.prepare(`SELECT id, username FROM users WHERE username = ? AND password_hash = ?`).bind(username, passwordHash).first();
        if (!user) {
          return new Response(JSON.stringify({ error: "Неверный логин или пароль" }), { status: 401, headers: corsHeaders });
        }

        const walletData = await env.DB.prepare(`SELECT wallet_address FROM user_wallets WHERE user_id = ?`).bind(user.id).first();
        return new Response(JSON.stringify({ 
          success: true, 
          user: { username: user.username, wallet: walletData ? walletData.wallet_address : null } 
        }), { status: 200, headers: corsHeaders });
      }

      // 3. СПИСАНИЕ БАЛЛОВ ЗА РАЗМЕЩЕНИЕ КАРТИНЫ (ФИКСИРОВАННО 10 БАЛЛОВ)
      if (workerUrl.pathname === "/api/publish-artwork") {
        const { username, password, artworkTitle } = body;
        if (!username || !password) {
          return new Response(JSON.stringify({ error: "Ошибка авторизации" }), { status: 400, headers: corsHeaders });
        }

        const passwordHash = await hashPassword(password);
        const user = await env.DB.prepare(`SELECT id FROM users WHERE username = ? AND password_hash = ?`).bind(username, passwordHash).first();
        if (!user) {
          return new Response(JSON.stringify({ error: "Неверный логин или пароль" }), { status: 401, headers: corsHeaders });
        }

        await syncSpentPointsWithPlacedPaintings(env, user.id, username);

        const walletData = await env.DB.prepare(`SELECT wallet_address FROM user_wallets WHERE user_id = ?`).bind(user.id).first();
        
        let concealPointsEarned = 0;
        let kowasugiCalculated = 0;

        if (walletData) {
          const [kowasugiData, concealEarned] = await Promise.all([
            calculateKowasugiPoints(POLYGON_RPC_URL, walletData.wallet_address, KOWASUGI_CONTRACT),
            calculateConcealPoints(POLYGON_RPC_URL, walletData.wallet_address, CONCEAL_CONTRACT)
          ]);
          kowasugiCalculated = kowasugiData.calculatedPoints;
          concealPointsEarned = concealEarned;
        }

        const totalEarnedPoints = kowasugiCalculated + concealPointsEarned;
        
        // Суммируем все траты и бонусы (бонус -100 уменьшит общую сумму spent, тем самым увеличив доступные баллы)
        const spentRes = await env.DB.prepare(`SELECT SUM(amount) as total_spent FROM user_points_spent WHERE user_id = ?`).bind(user.id).first();
        const totalSpent = spentRes?.total_spent || 0;

        const availablePoints = totalEarnedPoints - totalSpent;

        if (availablePoints < COST_PER_ACTION) {
          return new Response(JSON.stringify({ 
            error: `Недостаточно баллов. Требуется ${COST_PER_ACTION}, а доступно ${availablePoints.toFixed(2)}` 
          }), { status: 400, headers: corsHeaders });
        }

        const description = artworkTitle ? `Размещение картины: "${artworkTitle}"` : "Размещение картины";
        
        await env.DB.prepare(
          `INSERT INTO user_points_spent (user_id, amount, description, painting_id) VALUES (?, ?, ?, ?)`
        ).bind(user.id, COST_PER_ACTION, description, artworkTitle || null).run();

        return new Response(JSON.stringify({ 
          success: true, 
          spent: COST_PER_ACTION, 
          remainingPoints: (availablePoints - COST_PER_ACTION).toFixed(2),
          message: "Картина успешно опубликована, списано 10 баллов."
        }), { status: 200, headers: corsHeaders });
      }

      // 4. ПРИВЯЗКА ИЛИ РАСЧЕТ БАЛАНСА
      if (workerUrl.pathname === "/api/link-wallet") {
        const { username, password, walletAddress, signature, message } = body;

        const passwordHash = await hashPassword(password);
        const user = await env.DB.prepare(`SELECT id FROM users WHERE username = ? AND password_hash = ?`).bind(username, passwordHash).first();
        if (!user) {
          return new Response(JSON.stringify({ error: "Сессия устарела" }), { status: 401, headers: corsHeaders });
        }

        if (!walletAddress) {
          return new Response(JSON.stringify({ error: "Необходим адрес кошелька" }), { status: 400, headers: corsHeaders });
        }

        const cleanWallet = walletAddress.toLowerCase().trim();

        if (signature && message) {
          const expectedMessage = `Authorize wallet ${cleanWallet} for account ${username}`;
          if (message !== expectedMessage) {
            return new Response(JSON.stringify({ error: "Неверный текст сообщения" }), { status: 400, headers: corsHeaders });
          }

          const isValid = await verifySignatureOnChain(POLYGON_RPC_URL, message, signature, cleanWallet);
          if (!isValid) {
            return new Response(JSON.stringify({ error: "Подпись не прошла проверку!" }), { status: 403, headers: corsHeaders });
          }

          await env.DB.prepare(
            `INSERT INTO user_wallets (user_id, wallet_address) VALUES (?, ?)
             ON CONFLICT(user_id) DO UPDATE SET wallet_address = EXCLUDED.wallet_address`
          ).bind(user.id, cleanWallet).run();
        }

        try {
          await syncSpentPointsWithPlacedPaintings(env, user.id, username);

          const [concealBal, concealPointsEarned, kowasugiData, spentRes, transfersIn, transfersOut] = await Promise.all([
            getErc20Balance(POLYGON_RPC_URL, CONCEAL_CONTRACT, cleanWallet, 6),
            calculateConcealPoints(POLYGON_RPC_URL, cleanWallet, CONCEAL_CONTRACT),
            calculateKowasugiPoints(POLYGON_RPC_URL, cleanWallet, KOWASUGI_CONTRACT),
            env.DB.prepare(`SELECT SUM(amount) as total_spent FROM user_points_spent WHERE user_id = ?`).bind(user.id).first(),
            getTransfers(POLYGON_RPC_URL, KOWASUGI_CONTRACT, cleanWallet, "IN"),
            getTransfers(POLYGON_RPC_URL, KOWASUGI_CONTRACT, cleanWallet, "OUT")
          ]);

          let concealTier = concealBal >= 1000 ? 2 : (concealBal >= 100 ? 1 : 0);
          let kowasugiTier = kowasugiData.currentBalance >= 4444 ? 2 : (kowasugiData.currentBalance >= 1333 ? 1 : 0);

          const totalEarnedPoints = kowasugiData.calculatedPoints + concealPointsEarned;
          const totalSpent = spentRes?.total_spent || 0; // Сюда входит и приветственный бонус (-100), уменьшающий общие "траты"
          const finalAvailablePoints = Math.max(0, totalEarnedPoints - totalSpent);

          const rawHistory = [];
          transfersIn.forEach(tx => rawHistory.push({ block: parseInt(tx.blockNum, 16), type: "IN", amount: parseFloat(tx.value || 0) }));
          transfersOut.forEach(tx => rawHistory.push({ block: parseInt(tx.blockNum, 16), type: "OUT", amount: parseFloat(tx.value || 0) }));
          rawHistory.sort((a, b) => a.block - b.block);

          return new Response(JSON.stringify({ 
            success: true, 
            walletAddress: cleanWallet, 
            balance: kowasugiData.currentBalance.toFixed(2),
            tier: kowasugiTier,
            points: finalAvailablePoints.toFixed(2),
            totalEarned: totalEarnedPoints.toFixed(2),
            totalSpent: totalSpent.toFixed(2),
            polygonTokens: {
              conceal: { balance: concealBal.toFixed(2), tier: concealTier }
            }
          }), { status: 200, headers: corsHeaders });

        } catch (apiErr) {
          return new Response(JSON.stringify({ error: `Ошибка расчета: ${apiErr.message}` }), { status: 500, headers: corsHeaders });
        }
      }
    }
    return new Response("Not Found", { status: 404, headers: corsHeaders });
  }
};