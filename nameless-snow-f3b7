const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type",
};

// Фиксированная стоимость действия в баллах
const COST_PER_ACTION = 10; 

async function hashPassword(password) {
  const msgBuffer = new TextEncoder().encode(password);
  const hashBuffer = await crypto.subtle.digest("SHA-256", msgBuffer);
  return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, "0")).join("");
}

async function verifySignatureOnChain(rpcUrl, message, signatureHex, expectedAddress) {
  try {
    const cleanAddress = expectedAddress.toLowerCase().trim();
    const messageBytes = new TextEncoder().encode(message);
    const prefix = `\x19Ethereum Signed Message:\n${messageBytes.length}`;
    const prefixBytes = new TextEncoder().encode(prefix);
    
    const ethMessageBytes = new Uint8Array(prefixBytes.length + messageBytes.length);
    ethMessageBytes.set(prefixBytes);
    ethMessageBytes.set(messageBytes, prefixBytes.length);
    
    const ethMessageHex = "0x" + Array.from(ethMessageBytes).map(b => b.toString(16).padStart(2, "0")).join("");
    
    const sha3Response = await fetch(rpcUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "web3_sha3", params: [ethMessageHex] })
    });
    const sha3Data = await sha3Response.json();
    const messageHash = sha3Data.result;

    const sig = signatureHex.startsWith("0x") ? signatureHex.slice(2) : signatureHex;
    if (sig.length !== 130) return false;

    const r = sig.slice(0, 64);
    const s = sig.slice(64, 128);
    let vVal = parseInt(sig.slice(128, 130), 16);
    if (vVal < 27) vVal += 27;
    const v = vVal.toString(16).padStart(64, "0");

    const cleanHash = messageHash.startsWith("0x") ? messageHash.slice(2) : messageHash;
    const callData = "0x" + cleanHash + v + r + s;

    const callResponse = await fetch(rpcUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        jsonrpc: "2.0",
        id: 2,
        method: "eth_call",
        params: [{ to: "0x0000000000000000000000000000000000000001", data: callData }, "latest"]
      })
    });
    const callDataJson = await callResponse.json();
    
    if (callDataJson.result && callDataJson.result !== "0x") {
      const recoveredAddress = "0x" + callDataJson.result.slice(-40).toLowerCase();
      return recoveredAddress === cleanAddress;
    }
    return false;
  } catch (e) {
    console.error("Ошибка верификации подписи:", e);
    return false;
  }
}

async function getErc20Balance(rpcUrl, contractAddress, walletAddress, decimals = 18) {
  try {
    const cleanWallet = walletAddress.replace("0x", "").padStart(64, "0");
    const data = "0x70a08231" + cleanWallet;
    
    const res = await fetch(rpcUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        jsonrpc: "2.0",
        id: 1,
        method: "eth_call",
        params: [{ to: contractAddress, data: data }, "latest"]
      })
    });
    const json = await res.json();
    if (!json.result || json.result === "0x") return 0;
    return parseInt(json.result, 16) / Math.pow(10, decimals);
  } catch (e) {
    return 0;
  }
}

async function getTransfers(rpcUrl, tokenAddress, walletAddress, direction) {
  const params = {
    fromBlock: "0x0",
    toBlock: "latest",
    contractAddresses: [tokenAddress],
    category: ["erc20"],
    excludeZeroValue: true,
  };

  if (direction === "IN") params.toAddress = walletAddress;
  else params.fromAddress = walletAddress;

  const response = await fetch(rpcUrl, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      jsonrpc: "2.0",
      id: direction === "IN" ? 10 : 11,
      method: "alchemy_getAssetTransfers",
      params: [params]
    })
  });

  const data = await response.json();
  if (data.error) throw new Error(`Alchemy API Error: ${JSON.stringify(data.error)}`);
  return data.result?.transfers || [];
}

async function getBlockTimestamp(rpcUrl, blockNumberHex) {
  const response = await fetch(rpcUrl, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      jsonrpc: "2.0",
      id: 100,
      method: "eth_getBlockByNumber",
      params: [blockNumberHex, false]
    })
  });
  const data = await response.json();
  if (data.result && data.result.timestamp) {
    return parseInt(data.result.timestamp, 16);
  }
  return null;
}

// Расчет начисленных баллов для Kowasugi (коэффициент 0.001)
async function calculateKowasugiPoints(rpcUrl, walletAddress, contractAddress) {
  const [transfersIn, transfersOut] = await Promise.all([
    getTransfers(rpcUrl, contractAddress, walletAddress, "IN"),
    getTransfers(rpcUrl, contractAddress, walletAddress, "OUT")
  ]);

  const rawHistory = [];
  const uniqueBlocks = new Set();

  transfersIn.forEach(tx => {
    rawHistory.push({ blockHex: tx.blockNum, block: parseInt(tx.blockNum, 16), type: "IN", amount: parseFloat(tx.value || 0) });
    uniqueBlocks.add(tx.blockNum);
  });

  transfersOut.forEach(tx => {
    rawHistory.push({ blockHex: tx.blockNum, block: parseInt(tx.blockNum, 16), type: "OUT", amount: parseFloat(tx.value || 0) });
    uniqueBlocks.add(tx.blockNum);
  });

  rawHistory.sort((a, b) => a.block - b.block);

  const blockTimestamps = {};
  const blockList = Array.from(uniqueBlocks);
  
  await Promise.all(
    blockList.map(async (blockHex) => {
      try {
        const ts = await getBlockTimestamp(rpcUrl, blockHex);
        if (ts) blockTimestamps[blockHex] = ts;
      } catch (e) {}
    })
  );

  const SECONDS_IN_DAY = 86400;
  const POINTS_PER_TOKEN_PER_DAY = 0.001; 

  let currentBalance = 0;
  let calculatedPoints = 0;
  let lastTimestamp = rawHistory.length > 0 ? blockTimestamps[rawHistory[0].blockHex] : null;

  rawHistory.forEach(tx => {
    const txTimestamp = blockTimestamps[tx.blockHex] || lastTimestamp;

    if (currentBalance > 0 && txTimestamp && lastTimestamp && txTimestamp > lastTimestamp) {
      const secondsHeld = txTimestamp - lastTimestamp;
      calculatedPoints += currentBalance * POINTS_PER_TOKEN_PER_DAY * (secondsHeld / SECONDS_IN_DAY);
    }

    if (txTimestamp) lastTimestamp = txTimestamp;
    if (tx.type === "IN") currentBalance += tx.amount;
    else currentBalance -= tx.amount;
  });

  const nowInSeconds = Math.floor(Date.now() / 1000);
  if (currentBalance > 0 && lastTimestamp && nowInSeconds > lastTimestamp) {
    calculatedPoints += currentBalance * POINTS_PER_TOKEN_PER_DAY * ((nowInSeconds - lastTimestamp) / SECONDS_IN_DAY);
  }

  return { currentBalance, calculatedPoints };
}

